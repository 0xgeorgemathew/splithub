# Local development environment (vite dev runs the Worker in workerd with local D1/R2/DO/Workflows).
# Copy to .env.local and fill in values. Production: public values in .env.production,
# secrets on the Worker (see cloudflare.config.ts).

# Privy Auth - https://dashboard.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Vincent app origin used for Vincent connect redirects
VINCENT_APP_URL=http://localhost:3000

# OpenAI Planner (server-side only)
OPENAI_API_KEY=sk_your_openai_key

# Relayer (server-side only - pays gas for gasless transactions)
RELAYER_PRIVATE_KEY=0x...

# OneSignal Push Notifications - https://onesignal.com/
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_app_id
ONESIGNAL_REST_API_KEY=your_rest_api_key  # server-side only

# App URL for deep links and OAuth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ERC-8004 trust chain RPC (Ethereum Sepolia) and registries (current public testnet bundle)
ERC8004_TRUST_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_VALIDATION_REGISTRY_ADDRESS=0x8004Cb1BF31DAf7788923b405b754f57acEB4272
ERC8004_REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713

# OpenAI Store Agent
OPENAI_API_KEY=sk-...
OPENAI_STORE_AGENT_MODEL=gpt-5.4-mini

# Supplier adapter for autonomous restock actions
STORE_SUPPLIER_WEBHOOK_URL=https://your-supplier-adapter.example.com/restock
STORE_SUPPLIER_SHARED_SECRET=your_webhook_secret
STORE_SUPPLIER_TIMEOUT_MS=15000
